# Run scripts/setup.mjs in the Node container to generate local credentials.
# Never commit .env. Empty values below are intentionally not usable passwords.
APP_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgresql://exhibition:@localhost:55432/exhibition
PGHOST=postgres
PGPORT=5432
PGUSER=exhibition
PGDATABASE=exhibition
PGPASSWORD=
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
S3_ENDPOINT=http://rustfs:9000
S3_PUBLIC_ENDPOINT=http://localhost:19000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=exhibition-dev
S3_REGION=us-east-1
WEB_ORIGIN=http://localhost:5173
API_INTERNAL_URL=http://api:3000
HOST=0.0.0.0
PORT=3000
API_PORT=3000
WEB_PORT=5173
POSTGRES_PORT=55432
REDIS_PORT_HOST=56379
S3_PORT=19000
S3_CONSOLE_PORT=19001

# Mail (SMTP) — 开发环境留空使用日志模式，或指向 mailpit
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com

# AI Provider — 凭证仅写入未跟踪的 .env
# AI_PROVIDER_MODE=mock  # mock | real（默认 mock，production 禁止 mock）
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# AI_DEFAULT_TEXT_MODEL=gpt-5.6-terra   # 真实文本模型 ID
# AI_DEFAULT_IMAGE_MODEL=gpt-image-2.5-flare
# AI_DEFAULT_IMAGE_QUALITY=medium
